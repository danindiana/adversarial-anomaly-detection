digraph future_directions {
    graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica",
           fontcolor="#e6edf3", labelloc="t", fontsize=20, nodesep=0.3, ranksep=0.7,
           label="Future directions (roadmap; nothing to the right of 'done' is built yet)\n"];
    node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d",
           style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18",
           fillcolor="#161b22"];
    edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7",
           penwidth=1.6, arrowsize=0.9];

    subgraph cluster_done {
        label="Done"; style="rounded"; color="#3fb950"; fontcolor="#3fb950";
        d1 [label="v1.3 game + mixed frontier", color="#3fb950", fillcolor="#1f2937"];
        d2 [label="v1.4.2 protected-Σ benchmark", color="#3fb950", fillcolor="#1f2937"];
        d3 [label="Ad case study (synthetic)", color="#3fb950", fillcolor="#1f2937"];
    }

    subgraph cluster_next {
        label="Next"; style="rounded"; color="#58a6ff"; fontcolor="#58a6ff";
        n1 [label="v1.4 estimated Σ̂_T\nF(k, T−k) calibration\nfull vs structured estimators\nfrontier shift Δ(w) ≥ 0", color="#58a6ff", fillcolor="#13294d"];
        n2 [label="Criteo uplift: first real data\nplanted attribution thieves", color="#58a6ff", fillcolor="#13294d"];
    }

    subgraph cluster_later {
        label="Later"; style="rounded"; color="#bc8cff"; fontcolor="#bc8cff";
        l1 [label="Attackable Σ: calibration poisoning\nprivate randomized calibration membership", color="#bc8cff", fillcolor="#13294d"];
        l2 [label="Multichannel ad test on outcome vector\nwhere does the ad signal go?", color="#bc8cff", fillcolor="#13294d"];
        l3 [label="Policy-response experiments:\ndoes the anomaly move with scrutiny?", color="#bc8cff", fillcolor="#13294d"];
    }

    subgraph cluster_open {
        label="Open questions (speculative)"; style="rounded,dashed"; color="#f0883e"; fontcolor="#f0883e";
        o1 [label="Metric gaming in general:\nhospitals, schools, KPIs, AI evals", color="#f0883e"];
        o2 [label="Real sensor networks with\ncorrelated common-cause failures", color="#f0883e"];
    }

    d2 -> n1; d1 -> n1 [style=dashed]; d3 -> n2;
    n1 -> l1; n1 -> l2; n2 -> l2; n2 -> l3;
    l2 -> o1; l1 -> o2; l3 -> o1 [style=dashed];
}
